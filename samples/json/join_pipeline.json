{
  "name": "Join Pipeline",
  "nodes": [
    {
      "id": "1",
      "type": "fetch_internal",
      "name": "Fetch Customers",
      "params": { "key": "cleaned_customers" }
    },
    {
      "id": "2",
      "type": "fetch_internal",
      "name": "Fetch Mid",
      "params": { "key": "cleaned_mid" }
    },
    {
      "id": "3",
      "type": "join",
      "name": "Join Customers With Amounts",
      "params": { "on": ["customer"], "how": "inner" }
    },
    {
      "id": "4",
      "type": "push_internal",
      "name": "Export Result",
      "params": { "key": "cleaned_joined" }
    }
  ],
  "connections": [
    { "from": "1", "to": "3", "into": "left" },
    { "from": "2", "to": "3", "into": "right" },
    { "from": "3", "to": "4" }
  ]
}
