{
  "name": "Switch Amount Bucket Pipeline",
  "nodes": [
    {
      "id": "1",
      "type": "fetch_internal",
      "name": "Fetch Data",
      "params": { "key": "raw" }
    },
    {
      "id": "2",
      "type": "select",
      "name": "Select Columns",
      "params": { "columns": ["customer", "amount", "quantity"] }
    },
    {
      "id": "3",
      "type": "fill_mean",
      "name": "Fill Missing (Mean)",
      "params": { "columns": ["amount", "quantity"] }
    },
    {
      "id": "4",
      "type": "switch",
      "name": "Bucket By Amount",
      "params": {
        "expression": "pl.when(df.amount.mean() >= 150).then(pl.lit('high')).when(df.amount.mean() >= 80).then(pl.lit('mid')).otherwise(pl.lit('low'))",
        "cases": ["high", "mid", "low"]
      }
    },
    {
      "id": "5",
      "type": "push_internal",
      "name": "Export High Value",
      "params": { "key": "cleaned_high" }
    },
    {
      "id": "6",
      "type": "select",
      "name": "Select Mid Columns",
      "params": { "columns": ["customer", "amount"] }
    },
    {
      "id": "7",
      "type": "push_internal",
      "name": "Export Mid Value",
      "params": { "key": "cleaned_mid" }
    },
    {
      "id": "8",
      "type": "push_internal",
      "name": "Export Low Value",
      "params": { "key": "cleaned_low" }
    }
  ],
  "connections": [
    { "from": "1", "to": "2" },
    { "from": "2", "to": "3" },
    { "from": "3", "to": "4" },
    { "from": "4", "to": "5", "on": "high" },
    { "from": "4", "to": "6", "on": "mid" },
    { "from": "6", "to": "7" },
    { "from": "4", "to": "8", "on": "low" }
  ]
}
